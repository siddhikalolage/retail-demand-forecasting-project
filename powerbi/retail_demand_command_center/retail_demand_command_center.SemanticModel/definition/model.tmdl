model Model

	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US

	annotation __PBI_TimeIntelligenceEnabled = 0
	annotation PBI_ProTooling = ["DevMode"]
	annotation PBI_QueryOrder = ["DIM_CALENDAR","DIM_ITEM","DIM_STORE","FACT_DAILY_SALES","MART_FORECAST_VS_ACTUAL"]

	ref table DIM_CALENDAR
	ref table DIM_ITEM
	ref table DIM_STORE
	ref table FACT_DAILY_SALES
	ref table MART_FORECAST_VS_ACTUAL
	ref table _Measures

	ref expression PBI_Snowflake_Account
	ref expression PBI_Snowflake_Warehouse
	ref expression PBI_Snowflake_Role
	ref expression PBI_Snowflake_Database

	ref cultureInfo en-US

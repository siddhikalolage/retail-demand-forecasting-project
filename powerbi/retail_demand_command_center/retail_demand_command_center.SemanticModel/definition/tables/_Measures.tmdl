table _Measures
	lineageTag: 7f6a9a2d-fb3b-4928-8065-c3c9e7aa0004

	measure 'Total Revenue' = SUM(FACT_DAILY_SALES[REVENUE_AMOUNT_USD])
		formatString: $#,0;($#,0);$#,0

	measure 'Total Units' = SUM(FACT_DAILY_SALES[UNITS_SOLD])
		formatString: #,0

	measure 'Avg Selling Price' = DIVIDE([Total Revenue], [Total Units])
		formatString: $#,0.00;($#,0.00);$#,0.00

	measure 'Active Stores' = DISTINCTCOUNT(FACT_DAILY_SALES[STORE_KEY])
		formatString: #,0

	measure 'Active Items' = DISTINCTCOUNT(FACT_DAILY_SALES[ITEM_KEY])
		formatString: #,0

	measure 'Revenue Prior Year' = CALCULATE([Total Revenue], DATEADD(DIM_CALENDAR[CALENDAR_DATE], -1, YEAR))
		formatString: $#,0;($#,0);$#,0

	measure 'Revenue Growth %' = DIVIDE([Total Revenue] - [Revenue Prior Year], [Revenue Prior Year])
		formatString: 0.0%;(0.0%);0.0%

	measure 'Revenue 30D Average' =
		VAR LatestActualDate = MAX(FACT_DAILY_SALES[SALE_DATE])
		VAR DatesToAverage = DATESINPERIOD(DIM_CALENDAR[CALENDAR_DATE], LatestActualDate, -30, DAY)
		RETURN IF(ISBLANK(LatestActualDate), BLANK(), AVERAGEX(DatesToAverage, [Total Revenue]))
		formatString: $#,0;($#,0);$#,0

	measure 'Units 30D Average' =
		VAR LatestActualDate = MAX(FACT_DAILY_SALES[SALE_DATE])
		VAR DatesToAverage = DATESINPERIOD(DIM_CALENDAR[CALENDAR_DATE], LatestActualDate, -30, DAY)
		RETURN IF(ISBLANK(LatestActualDate), BLANK(), AVERAGEX(DatesToAverage, [Total Units]))
		formatString: #,0

	measure 'Units vs 30D Average %' = DIVIDE([Total Units] - [Units 30D Average], [Units 30D Average])
		formatString: 0.0%;(0.0%);0.0%

	measure 'Revenue Share %' = DIVIDE([Total Revenue], CALCULATE([Total Revenue], ALL(DIM_ITEM), ALL(DIM_STORE)))
		formatString: 0.0%;(0.0%);0.0%

	measure 'Price Prior Year' = CALCULATE([Avg Selling Price], DATEADD(DIM_CALENDAR[CALENDAR_DATE], -1, YEAR))
		formatString: $#,0.00;($#,0.00);$#,0.00

	measure 'Price Change %' = DIVIDE([Avg Selling Price] - [Price Prior Year], [Price Prior Year])
		formatString: 0.0%;(0.0%);0.0%

	measure 'Holiday Revenue Share %' = DIVIDE(CALCULATE([Total Revenue], DIM_CALENDAR[IS_HOLIDAY] = TRUE()), [Total Revenue])
		formatString: 0.0%;(0.0%);0.0%

	measure 'SNAP Revenue Share %' = DIVIDE(CALCULATE([Total Revenue], DIM_CALENDAR[SNAP Day Type] = "SNAP Day"), [Total Revenue])
		formatString: 0.0%;(0.0%);0.0%

	measure 'Actual Units' = CALCULATE(SUM(MART_FORECAST_VS_ACTUAL[UNITS]), KEEPFILTERS(MART_FORECAST_VS_ACTUAL[SERIES_TYPE] = "actual"))
		formatString: #,0

	measure 'Forecast Units' = CALCULATE(SUM(MART_FORECAST_VS_ACTUAL[UNITS]), KEEPFILTERS(MART_FORECAST_VS_ACTUAL[SERIES_TYPE] = "forecast"))
		formatString: #,0

	measure 'Forecast Revenue' = CALCULATE(SUM(MART_FORECAST_VS_ACTUAL[REVENUE_USD]), KEEPFILTERS(MART_FORECAST_VS_ACTUAL[SERIES_TYPE] = "forecast"))
		formatString: $#,0;($#,0);$#,0

	measure 'Forecast Lower 95' = CALCULATE(SUM(MART_FORECAST_VS_ACTUAL[UNITS_LOWER_95]), KEEPFILTERS(MART_FORECAST_VS_ACTUAL[SERIES_TYPE] = "forecast"))
		formatString: #,0

	measure 'Forecast Upper 95' = CALCULATE(SUM(MART_FORECAST_VS_ACTUAL[UNITS_UPPER_95]), KEEPFILTERS(MART_FORECAST_VS_ACTUAL[SERIES_TYPE] = "forecast"))
		formatString: #,0

	measure 'Forecast Coverage Days' = CALCULATE(DISTINCTCOUNT(MART_FORECAST_VS_ACTUAL[OBSERVATION_DATE]), KEEPFILTERS(MART_FORECAST_VS_ACTUAL[SERIES_TYPE] = "forecast"))
		formatString: #,0

	measure 'Forecast Start Date' = CALCULATE(MIN(MART_FORECAST_VS_ACTUAL[OBSERVATION_DATE]), KEEPFILTERS(MART_FORECAST_VS_ACTUAL[SERIES_TYPE] = "forecast"))
		formatString: yyyy-mm-dd

	measure 'Forecast End Date' = CALCULATE(MAX(MART_FORECAST_VS_ACTUAL[OBSERVATION_DATE]), KEEPFILTERS(MART_FORECAST_VS_ACTUAL[SERIES_TYPE] = "forecast"))
		formatString: yyyy-mm-dd

	measure 'Forecast Interval Width %' = DIVIDE([Forecast Upper 95] - [Forecast Lower 95], [Forecast Units])
		formatString: 0.0%;(0.0%);0.0%

	measure 'Forecast Risk Status' =
		SWITCH(
			TRUE(),
			ISBLANK([Forecast Units]), "No forecast in current selection",
			[Forecast Interval Width %] > 0.75, "High uncertainty - plan conservatively",
			[Forecast Interval Width %] > 0.40, "Monitor - widen replenishment buffer",
			"Planning-ready"
		)

	measure 'Demand Signal' =
		SWITCH(
			TRUE(),
			ISBLANK([Units 30D Average]), "No historical baseline",
			[Units vs 30D Average %] > 0.10, "Demand accelerating",
			[Units vs 30D Average %] < -0.10, "Demand softening",
			"Demand stable"
		)

	measure 'Pricing Signal' =
		SWITCH(
			TRUE(),
			ISBLANK([Price Prior Year]), "No comparable price history",
			[Price Change %] > 0.05 && [Units vs 30D Average %] < -0.10, "Price increase with demand decline",
			[Price Change %] < -0.05 && [Units vs 30D Average %] > 0.10, "Discount appears to lift demand",
			"No clear price-demand warning"
		)

	measure 'Recommended Action' =
		SWITCH(
			TRUE(),
			[Forecast Risk Status] = "High uncertainty - plan conservatively", "Use a conservative reorder quantity and review inputs before release.",
			[Demand Signal] = "Demand accelerating", "Prioritize replenishment for accelerating item-store combinations.",
			[Demand Signal] = "Demand softening", "Investigate price, event, and local availability drivers before replenishment.",
			[Pricing Signal] = "Price increase with demand decline", "Test a targeted price adjustment or promotion; monitor margin impact.",
			"Maintain the current plan and monitor the next refresh."
		)

	measure 'Model Coverage Status' = IF(ISBLANK([Forecast Units]), "Historical view - no forecast available", "Forecast coverage available")

# =============================================================================
# .env.example — template for environment secrets
# =============================================================================
# This file IS committed to git as a reference.
# Copy this file to `.env` and fill in your actual values.
# `.env` is gitignored — real secrets never enter the repository.
# =============================================================================

# -----------------------------------------------------------------------------
# Azure SQL Database — Source OLTP Database
# =============================================================================
# Replace with your Azure SQL Server details
AZURE_SQL_SERVER=<your-azure-sql-server-name>.database.windows.net
AZURE_SQL_DATABASE=<your-database-name>
AZURE_SQL_USER=<your-sql-username>
AZURE_SQL_PASSWORD=<your-sql-password>

# Optional: connection timeout (seconds)
AZURE_SQL_CONNECTION_TIMEOUT=30

# -----------------------------------------------------------------------------
# Snowflake — Cloud Warehouse
# =============================================================================
# Replace with your Snowflake account details
SNOWFLAKE_ACCOUNT=<your-snowflake-account-identifier>
SNOWFLAKE_USER=<your-snowflake-username>
SNOWFLAKE_PASSWORD=<your-snowflake-password>
SNOWFLAKE_WAREHOUSE=<your-warehouse-name>
SNOWFLAKE_DATABASE=<your-database-name>
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=<your-role-name>

# Optional: Snowflake region (e.g., us-east-1)
# SNOWFLAKE_REGION=<your-region>

# Optional: Snowflake warehouse size (e.g., XSMALL, SMALL, MEDIUM)
# SNOWFLAKE_WAREHOUSE_SIZE=XSMALL

# Optional: Connection parameters
SNOWFLAKE_CONNECTION_TIMEOUT=30

# -----------------------------------------------------------------------------
# Kaggle API — M5 Dataset Download
# =============================================================================
# The Kaggle CLI typically reads credentials from ~/.kaggle/kaggle.json
# Set these variables only if you need to override the default location
KAGGLE_USERNAME=<your-kaggle-username>
KAGGLE_KEY=<your-kaggle-api-token>

# Optional: Kaggle cache directory
# KAGGLE_CACHE_PATH=~/.kaggle
